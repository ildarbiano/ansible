<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Управление нагрузкой стенда</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a3e 100%);
            color: #e0e0e0;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: rgba(255,255,255,0.03);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        h1 {
            font-size: 28px;
            background: linear-gradient(135deg, #64ffda, #4ad8b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }

        /* Вкладки */
        .tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 10px;
            flex-wrap: wrap;
        }
        .tab-btn {
            padding: 10px 24px;
            border: none;
            background: transparent;
            color: #8892b0;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s;
            font-family: inherit;
        }
        .tab-btn:hover {
            color: #64ffda;
            background: rgba(100,255,218,0.05);
        }
        .tab-btn.active {
            color: #64ffda;
            background: rgba(100,255,218,0.1);
            border-bottom: 2px solid #64ffda;
        }

        /* Содержимое вкладок */
        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .tab-content.active {
            display: block;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Сетка: слева управление, справа текст */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        @media (max-width: 768px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
            .grid-2 > div:first-child {
                order: 0;
            }
            .grid-2 > div:last-child {
                order: 1;
            }
        }

        .card {
            background: rgba(255,255,255,0.03);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .card-title {
            font-size: 14px;
            text-transform: uppercase;
            color: #8892b0;
            letter-spacing: 1px;
            margin-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 10px;
        }

        /* Текст вкладок */
        .tab-text {
            color: #ccd6f6;
            line-height: 1.8;
            font-size: 14px;
            background: rgba(255,255,255,0.03);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(255,255,255,0.05);
            min-height: 300px;
        }
        .tab-text h3 {
            color: #64ffda;
            margin-bottom: 10px;
            font-size: 18px;
        }
        .tab-text h4 {
            color: #ccd6f6;
            margin: 15px 0 8px 0;
            font-size: 16px;
            font-weight: 600;
        }
        .tab-text h5 {
            color: #8892b0;
            font-size: 15px;
            margin: 12px 0 6px 0;
            font-weight: 600;
        }
        .tab-text p {
            margin-bottom: 12px;
            color: #8892b0;
        }
        .tab-text ul {
            list-style: none;
            padding-left: 0;
        }
        .tab-text ul li {
            padding: 4px 0;
            padding-left: 20px;
            position: relative;
            color: #8892b0;
        }
        .tab-text ul li::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: #64ffda;
        }
        .tab-text ol {
            padding-left: 20px;
            color: #8892b0;
        }
        .tab-text ol li {
            padding: 4px 0;
        }
        .tab-text ol li ul {
            padding-left: 20px;
        }
        .tab-text ol li ul li {
            padding: 2px 0;
            padding-left: 20px;
        }
        .tab-text ol li ul li::before {
            content: '•';
            position: absolute;
            left: 0;
            color: #64ffda;
        }

        /* Таблицы */
        .tab-text table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            font-size: 13px;
        }
        .tab-text th {
            background: rgba(100,255,218,0.1);
            color: #64ffda;
            padding: 8px 10px;
            text-align: left;
            border-bottom: 2px solid #64ffda;
        }
        .tab-text td {
            padding: 6px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            color: #ccd6f6;
        }
        .tab-text tr:hover {
            background: rgba(255,255,255,0.03);
        }

        .tab-image {
            width: 100%;
            max-height: 200px;
            object-fit: contain;
            border-radius: 10px;
            background: rgba(255,255,255,0.03);
            padding: 10px;
            margin: 10px 0;
        }
        .tab-placeholder {
            color: #4a5a7a;
            text-align: center;
            padding: 40px 20px;
        }

        /* Регуляторы */
        .control-group { margin-bottom: 20px; }
        .control-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .control-label { font-size: 14px; color: #ccd6f6; }
        .control-value {
            font-size: 18px;
            font-weight: 600;
            color: #64ffda;
        }
        input[type="range"] {
            width: 100%;
            height: 4px;
            border-radius: 4px;
            background: rgba(255,255,255,0.1);
            -webkit-appearance: none;
            appearance: none;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #64ffda;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(100,255,218,0.3);
        }
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #64ffda, #4ad8b8);
            color: #0a0a1a;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(100,255,218,0.3);
        }

        /* Метрики */
        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .metric-item {
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }
        .metric-label {
            font-size: 11px;
            color: #8892b0;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .metric-value {
            font-size: 24px;
            font-weight: 700;
            color: #64ffda;
        }
        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 6px;
        }
        .status-dot.green { background: #64ffda; }
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            background: rgba(100,255,218,0.1);
            color: #64ffda;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>🚀 Управление нагрузкой стенда</h1>

    <!-- Вкладки (общие) -->
    <div class="tabs">
        <button class="tab-btn active" data-tab="tis">ТИС</button>
        <button class="tab-btn" data-tab="ais">АИС</button>
        <button class="tab-btn" data-tab="rais">РАИС</button>
    </div>

    <!-- Основное содержимое: управление слева, текст справа -->
    <div class="grid-2">
        <!-- ЛЕВАЯ КОЛОНКА: Управление и метрики (общие для всех вкладок) -->
        <div>
            <div class="card">
                <div class="card-title">Управление нагрузкой</div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">📥 GET запросы в %</span>
                        <span class="control-value" id="getValue">10</span>
                    </div>
                    <input type="range" id="getRate" min="0" max="100" value="10" oninput="updateSlider('getRate', 'getValue')">
                </div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">📤 POST запросы в %</span>
                        <span class="control-value" id="postValue">5</span>
                    </div>
                    <input type="range" id="postRate" min="0" max="50" value="5" oninput="updateSlider('postRate', 'postValue')">
                </div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">⏱️ Таймаут/Задержка (мс)</span>
                        <span class="control-value" id="timeoutValue">5000</span>
                    </div>
                    <input type="range" id="timeout" min="100" max="10000" value="5000" step="100" oninput="updateSlider('timeout', 'timeoutValue')">
                </div>
                <button class="btn-primary" onclick="applyLoad()">Применить настройки</button>
            </div>
            <div class="card" style="margin-top: 20px;">
                <div class="card-title">Метрики приложения</div>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <div class="metric-label">Всего запросов</div>
                        <div class="metric-value" id="totalRequests">0</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">Среднее время</div>
                        <div class="metric-value" id="avgResponseTime">0ms</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">Ошибки</div>
                        <div class="metric-value" id="errorRate">0%</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">RPS</div>
                        <div class="metric-value" id="currentRps">0</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ПРАВАЯ КОЛОНКА: Содержимое вкладки (меняется) -->
        <div>
            <!-- Вкладка ТИС -->
            <div id="tis" class="tab-content active">
                <div id="tis-text" class="tab-text">
                    <div class="tab-placeholder">Загрузка...</div>
                </div>
            </div>
            <!-- Вкладка АИС -->
            <div id="ais" class="tab-content">
                <div id="ais-text" class="tab-text">
                    <div class="tab-placeholder">Загрузка...</div>
                </div>
            </div>
            <!-- Вкладка РАИС -->
            <div id="rais" class="tab-content">
                <div id="rais-text" class="tab-text">
                    <div class="tab-placeholder">Загрузка...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Переключение вкладок
document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        document.getElementById(this.dataset.tab).classList.add('active');
        loadTabContent(this.dataset.tab);
    });
});

// Загрузка содержимого вкладки
async function loadTabContent(tabId) {
    const container = document.getElementById(tabId + '-text');
    if (!container) return;

    // Убираем проверку - всегда загружаем заново
    try {
        const response = await fetch('/ui/tabs/' + tabId + '.html');
        if (response.ok) {
            container.innerHTML = await response.text();
        } else {
            container.innerHTML = '<div class="tab-placeholder">❌ Ошибка загрузки содержимого</div>';
        }
    } catch (error) {
        console.error('Error loading tab content:', error);
        container.innerHTML = '<div class="tab-placeholder">❌ Ошибка загрузки: ' + error.message + '</div>';
    }
}

function updateSlider(sliderId, displayId) {
    const val = document.getElementById(sliderId).value;
    document.getElementById(displayId).textContent = val;
}

async function applyLoad() {
    const data = {
        getRate: parseInt(document.getElementById('getRate').value),
        postRate: parseInt(document.getElementById('postRate').value),
        timeout: parseInt(document.getElementById('timeout').value)
    };
    try {
        const response = await fetch('/ui/api/update-load', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        alert(result.success ? '✅ Настройки применены успешно!' : '❌ Ошибка: ' + result.error);
    } catch (error) {
        alert('❌ Ошибка соединения: ' + error.message);
    }
}

async function fetchMetrics() {
    try {
        const response = await fetch('/ui/api/metrics');
        const data = await response.json();
        if (data.success) {
            const m = data.metrics;
            document.getElementById('totalRequests').textContent = m.totalRequests || 0;
            document.getElementById('avgResponseTime').textContent = (m.avgResponseTime || 0) + 'ms';
            document.getElementById('errorRate').textContent = (m.errorRate || 0) + '%';
            document.getElementById('currentRps').textContent = m.currentRps || 0;
        }
    } catch (error) {
        console.error('Error fetching metrics:', error);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    loadTabContent('tis');
    setInterval(fetchMetrics, 5000);
    fetchMetrics();
});
</script>
</body>
</html>
