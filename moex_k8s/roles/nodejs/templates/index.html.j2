<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Управление нагрузкой стенда</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a3e 100%);
            color: #e0e0e0;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255,255,255,0.03);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        h1 {
            font-size: 28px;
            background: linear-gradient(135deg, #64ffda, #4ad8b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } }
        .card {
            background: rgba(255,255,255,0.03);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .card-title {
            font-size: 14px;
            text-transform: uppercase;
            color: #8892b0;
            letter-spacing: 1px;
            margin-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 10px;
        }
        .control-group { margin-bottom: 20px; }
        .control-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .control-label { font-size: 14px; color: #ccd6f6; }
        .control-value {
            font-size: 18px;
            font-weight: 600;
            color: #64ffda;
        }
        input[type="range"] {
            width: 100%;
            height: 4px;
            border-radius: 4px;
            background: rgba(255,255,255,0.1);
            -webkit-appearance: none;
            appearance: none;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #64ffda;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(100,255,218,0.3);
        }
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #64ffda, #4ad8b8);
            color: #0a0a1a;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(100,255,218,0.3);
        }
        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .metric-item {
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }
        .metric-label {
            font-size: 11px;
            color: #8892b0;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .metric-value {
            font-size: 24px;
            font-weight: 700;
            color: #64ffda;
        }
        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 6px;
        }
        .status-dot.green { background: #64ffda; }
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            background: rgba(100,255,218,0.1);
            color: #64ffda;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>🚀 Управление нагрузкой</h1>
    <div class="grid-2">
        <div>
            <div class="card">
                <div class="card-title">📊 Статус сервисов</div>
                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <span class="status-badge"><span class="status-dot green"></span> Nginx</span>
                    <span class="status-badge"><span class="status-dot green"></span> Tomcat</span>
                    <span class="status-badge"><span class="status-dot green"></span> PostgreSQL</span>
                    <span class="status-badge"><span class="status-dot green"></span> Node.js</span>
                </div>
                <div style="margin-top: 15px; font-size: 13px; color: #8892b0;">
                    <p>Стенд для тестирования производительности микросервисной архитектуры</p>
                </div>
            </div>
            <div class="card" style="margin-top: 20px;">
                <div class="card-title">⚡ Быстрые пресеты</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <button onclick="setPreset('light')" style="padding: 10px; border-radius: 8px; border: 1px solid rgba(100,255,218,0.2); background: transparent; color: #64ffda; cursor: pointer;">🌱 Легкая</button>
                    <button onclick="setPreset('medium')" style="padding: 10px; border-radius: 8px; border: 1px solid rgba(246,168,69,0.2); background: transparent; color: #f6a845; cursor: pointer;">⚡ Средняя</button>
                    <button onclick="setPreset('heavy')" style="padding: 10px; border-radius: 8px; border: 1px solid rgba(255,107,107,0.2); background: transparent; color: #ff6b6b; cursor: pointer;">🔥 Высокая</button>
                    <button onclick="setPreset('stress')" style="padding: 10px; border-radius: 8px; border: 1px solid rgba(255,107,107,0.4); background: rgba(255,107,107,0.05); color: #ff6b6b; cursor: pointer;">💀 Стресс</button>
                </div>
            </div>
        </div>
        <div>
            <div class="card">
                <div class="card-title">🎛️ Регуляторы нагрузки</div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">📥 GET запросы/сек</span>
                        <span class="control-value" id="getValue">10</span>
                    </div>
                    <input type="range" id="getRate" min="0" max="100" value="10" 
                           oninput="updateSlider('getRate', 'getValue')">
                </div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">📤 POST запросы/сек</span>
                        <span class="control-value" id="postValue">5</span>
                    </div>
                    <input type="range" id="postRate" min="0" max="50" value="5" 
                           oninput="updateSlider('postRate', 'postValue')">
                </div>
                <div class="control-group">
                    <div class="control-header">
                        <span class="control-label">⏱️ Таймаут (мс)</span>
                        <span class="control-value" id="timeoutValue">5000</span>
                    </div>
                    <input type="range" id="timeout" min="100" max="10000" value="5000" step="100" 
                           oninput="updateSlider('timeout', 'timeoutValue')">
                </div>
                <button class="btn-primary" onclick="applyLoad()">Применить настройки</button>
            </div>
            <div class="card" style="margin-top: 20px;">
                <div class="card-title">📈 Метрики приложения</div>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <div class="metric-label">Всего запросов</div>
                        <div class="metric-value" id="totalRequests">0</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">Среднее время</div>
                        <div class="metric-value" id="avgResponseTime">0ms</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">Ошибки</div>
                        <div class="metric-value" id="errorRate">0%</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-label">RPS</div>
                        <div class="metric-value" id="currentRps">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function updateSlider(sliderId, displayId) {
    const val = document.getElementById(sliderId).value;
    document.getElementById(displayId).textContent = val;
}

async function applyLoad() {
    const data = {
        getRate: parseInt(document.getElementById('getRate').value),
        postRate: parseInt(document.getElementById('postRate').value),
        timeout: parseInt(document.getElementById('timeout').value)
    };
    try {
        const response = await fetch('/api/update-load', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            alert('✅ Настройки применены успешно!');
        } else {
            alert('❌ Ошибка: ' + result.error);
        }
    } catch (error) {
        alert('❌ Ошибка соединения: ' + error.message);
    }
}

function setPreset(preset) {
    const presets = {
        light: { get: 5, post: 2, timeout: 5000 },
        medium: { get: 25, post: 10, timeout: 3000 },
        heavy: { get: 60, post: 25, timeout: 2000 },
        stress: { get: 100, post: 50, timeout: 1000 }
    };
    const p = presets[preset];
    if (!p) return;
    document.getElementById('getRate').value = p.get;
    document.getElementById('postRate').value = p.post;
    document.getElementById('timeout').value = p.timeout;
    updateSlider('getRate', 'getValue');
    updateSlider('postRate', 'postValue');
    updateSlider('timeout', 'timeoutValue');
    applyLoad();
}

async function fetchMetrics() {
    try {
        const response = await fetch('/api/metrics');
        const data = await response.json();
        if (data.success) {
            const m = data.metrics;
            document.getElementById('totalRequests').textContent = m.totalRequests || 0;
            document.getElementById('avgResponseTime').textContent = (m.avgResponseTime || 0) + 'ms';
            document.getElementById('errorRate').textContent = (m.errorRate || 0) + '%';
            document.getElementById('currentRps').textContent = m.currentRps || 0;
        }
    } catch (error) {
        console.error('Error fetching metrics:', error);
    }
}

setInterval(fetchMetrics, 5000);
fetchMetrics();
</script>
</body>
</html>
